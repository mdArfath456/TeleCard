# ── Core ─────────────────────────────────────────────────────────────
PORT=8080
# Mongo equivalent of spring.datasource.url — use a full connection string
# (local: mongodb://127.0.0.1:27017/telecard, Atlas: mongodb+srv://user:pass@cluster.mongodb.net/telecard)
MONGO_URI=mongodb://127.0.0.1:27017/telecard
# Comma-separated origins are supported for local + deployed frontends.
FRONTEND_URL=http://localhost:5173

# ── JWT (maps directly to your jwt.* properties) ────────────────────
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
JWT_COOKIE_NAME=jwt
JWT_REFRESH_COOKIE_NAME=refreshJwt
# Use secure=true + SameSite=None when frontend and backend are on different
# domains over HTTPS (e.g. deployed). Locally over http, keep secure=false +
# SameSite=Lax or cookies won't be set by the browser.
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAME_SITE=Lax

# ── Admin seed account ───────────────────────────────────────────────


# ── Razorpay (optional) ──────────────────────────────────────────────
# Leave blank to disable Razorpay and use manual UPI/UTR verification only.
# Get test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Cloudinary (optional — maps to your cloudinary.* properties) ────
# Leave all three blank to store payment screenshots on local disk instead
# (uploads/payments/) — the app auto-detects which storage is active.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (optional — maps to your brevo.* / spring.mail.* properties) ─
# Two providers are supported, tried in this order, with automatic fallback:
#   1. Brevo transactional API (BREVO_API_KEY + BREVO_FROM_EMAIL)
#   2. Gmail SMTP via Nodemailer (MAIL_USERNAME + MAIL_PASSWORD — use a
#      Google App Password, not your normal password)
# Leave all blank to just log emails to the console instead (dev mode).
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=TeleCard

MAIL_USERNAME=
MAIL_PASSWORD=
